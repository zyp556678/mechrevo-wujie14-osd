[Unit]
Description=MECHREVO MIFS Fn-key OSD daemon
Documentation=file:///usr/share/doc/mifs-osd/README.md
After=multi-user.target
After=systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe acpi_call
ExecStart=/usr/libexec/mifs-osd/mifs-osdd
Restart=on-failure
RestartSec=2
# /proc/acpi/call is root-only; the daemon needs it.
User=root

[Install]
WantedBy=multi-user.target
